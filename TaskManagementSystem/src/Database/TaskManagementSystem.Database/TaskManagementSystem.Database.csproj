<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TaskManagementSystem.Database</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*" />
    <Compile Include="Placeholder.cs" />
    <Compile Include="SqlScriptSeeder.cs" />
    <Compile Include="DatabaseSchemaMigrator.cs" />
    <Compile Include="DatabaseStartupLog.cs" />
    <Compile Include="DatabaseVersionBootstrap.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\**\*.sql" />
    <None Include="Structure\**\*.sql" />
    <None Include="Structure\**\*.md" />
  </ItemGroup>
</Project>
