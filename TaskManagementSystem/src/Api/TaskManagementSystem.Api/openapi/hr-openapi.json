{
  "openapi": "3.0.3",
  "info": {
    "title": "TMS HR API (Dev)",
    "version": "1.0.0",
    "description": "HR Leave and Public Holidays endpoints for Task Management System.\n\n## Authentication (required)\nAll HR endpoints require a JWT Bearer token. Authenticate first using the **Auth** endpoints below.\n\n### Apidog quick start\n1. Run **POST /auth/login** with body `{ \"code\": \"TST001\" }` (seed Owner user from dev DB).\n2. Copy `accessToken` from the response.\n3. In Apidog: **Environment** or **Auth** → Bearer Token → paste the token (or set variable `accessToken` and use `Bearer {{accessToken}}`).\n4. Call any HR endpoint — requests without a valid token return **401**.\n\nRefresh: `POST /auth/refresh-token` uses the HttpOnly `refreshToken` cookie set on login."
  },
  "servers": [
    {
      "url": "http://localhost:61173",
      "description": "Local development (HTTP)"
    },
    {
      "url": "https://localhost:61172",
      "description": "Local development (HTTPS)"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Login and session — call before HR endpoints" },
    { "name": "HR Leave", "description": "Leave balances, requests, opinions, and settings" },
    { "name": "HR Holidays", "description": "Public holiday CRUD" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login with user code (dev seed: TST001)",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "code": "TST001" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token (refresh token set as HttpOnly cookie)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccessTokenResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/auth/refresh-token": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token using refreshToken cookie",
        "operationId": "refreshToken",
        "security": [],
        "responses": {
          "200": {
            "description": "New access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccessTokenResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/auth/about-me": {
      "post": {
        "tags": ["Auth"],
        "summary": "Get authenticated user profile",
        "operationId": "aboutMe",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthInfoResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/hr/leave/balances": {
      "get": {
        "tags": ["HR Leave"],
        "summary": "Get current user leave balances",
        "operationId": "getLeaveBalances",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current leave balances",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveBalancesResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/leave/leave-settings": {
      "get": {
        "tags": ["HR Leave"],
        "summary": "Get read-only leave configuration windows",
        "operationId": "getLeaveSettings",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Leave settings",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveSettingsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/hr/leave/leave-requests/preview": {
      "post": {
        "tags": ["HR Leave"],
        "summary": "Preview annual leave working days and from-next need",
        "operationId": "previewLeave",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PreviewLeaveRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PreviewLeaveResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/leave/leave-requests": {
      "get": {
        "tags": ["HR Leave"],
        "summary": "List own leave requests",
        "operationId": "getLeaveRequests",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Leave requests for the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LeaveRequestResponse" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["HR Leave"],
        "summary": "Create a leave request",
        "description": "Accepts JSON for most leave types, or multipart/form-data for sick leave with optional medical certificate upload.",
        "operationId": "requestLeave",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateLeaveRequest" }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["type", "startDate", "endDate"],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Leave type (e.g. Sick, Annual, Emergency)",
                    "example": "Sick"
                  },
                  "startDate": { "type": "string", "format": "date-time" },
                  "endDate": { "type": "string", "format": "date-time" },
                  "reason": { "type": "string", "nullable": true },
                  "noteForManager": { "type": "string", "nullable": true },
                  "confirmFromNextBalance": { "type": "boolean", "default": false },
                  "medicalCertificate": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Leave request created",
            "headers": {
              "Location": {
                "description": "URL of the created leave request",
                "schema": { "type": "string" },
                "example": "/hr/leave/leave-requests/1"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequestResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/leave/leave-requests/search": {
      "get": {
        "tags": ["HR Leave"],
        "summary": "Search leave requests with role-scoped filters",
        "operationId": "searchLeaveRequests",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1 } },
          { "name": "search", "in": "query", "schema": { "type": "string", "nullable": true } },
          { "name": "fromDate", "in": "query", "schema": { "type": "string", "format": "date-time", "nullable": true } },
          { "name": "toDate", "in": "query", "schema": { "type": "string", "format": "date-time", "nullable": true } },
          {
            "name": "status",
            "in": "query",
            "description": "LeaveStatus enum value",
            "schema": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Cancelled"], "nullable": true }
          },
          {
            "name": "type",
            "in": "query",
            "description": "LeaveType enum value",
            "schema": { "type": "string", "enum": ["Annual", "Sick", "Emergency", "UnpaidLeave", "FromNextBalance"], "nullable": true }
          },
          { "name": "myStatus", "in": "query", "schema": { "type": "string", "nullable": true } }
        ],
        "responses": {
          "200": {
            "description": "Paginated leave request list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequestListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/leave/leave-requests/pending": {
      "get": {
        "tags": ["HR Leave"],
        "summary": "List pending leave requests (Owner only)",
        "operationId": "getPendingLeaveRequests",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Pending leave requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LeaveRequestResponse" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/hr/leave/leave-requests/{id}": {
      "get": {
        "tags": ["HR Leave"],
        "summary": "Get leave request by ID",
        "operationId": "getLeaveRequestById",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "200": {
            "description": "Leave request with opinions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequestResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/hr/leave/leave-requests/{id}/medical-certificate": {
      "get": {
        "tags": ["HR Leave"],
        "summary": "Download sick leave medical certificate",
        "operationId": "getMedicalCertificate",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "200": {
            "description": "Medical certificate file",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/hr/leave/leave-requests/{id}/opinions": {
      "post": {
        "tags": ["HR Leave"],
        "summary": "Record leave opinion or Owner approve/reject",
        "operationId": "giveLeaveOpinion",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GiveLeaveOpinionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated leave request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequestResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/leave/leave-requests/opinions/bulk": {
      "post": {
        "tags": ["HR Leave"],
        "summary": "Bulk approve or reject leave requests (Owner only)",
        "operationId": "giveBulkLeaveOpinion",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GiveBulkLeaveOpinionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk operation summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BulkLeaveOpinionResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/hr/leave/leave-requests/{id}/cancel": {
      "put": {
        "tags": ["HR Leave"],
        "summary": "Cancel a pending or future approved leave request",
        "operationId": "cancelLeaveRequest",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "200": {
            "description": "Cancelled leave request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequestResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/leave/leave-requests/{id}/approve": {
      "post": {
        "tags": ["HR Leave"],
        "summary": "Owner approve leave request (alias for opinion approve)",
        "operationId": "approveLeaveRequest",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "200": {
            "description": "Approved leave request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveRequestResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/holidays": {
      "get": {
        "tags": ["HR Holidays"],
        "summary": "List public holidays",
        "operationId": "listHolidays",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "fromDate", "in": "query", "schema": { "type": "string", "format": "date-time", "nullable": true } },
          { "name": "toDate", "in": "query", "schema": { "type": "string", "format": "date-time", "nullable": true } }
        ],
        "responses": {
          "200": {
            "description": "Public holidays",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HolidayResponse" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["HR Holidays"],
        "summary": "Create a public holiday (ProjectManager+)",
        "operationId": "createHoliday",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateHolidayRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Holiday created",
            "headers": {
              "Location": {
                "description": "URL of the created holiday",
                "schema": { "type": "string" },
                "example": "/hr/holidays/1"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HolidayResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/hr/holidays/{id}": {
      "put": {
        "tags": ["HR Holidays"],
        "summary": "Update a public holiday (ProjectManager+)",
        "operationId": "updateHoliday",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateHolidayRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated holiday",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HolidayResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "delete": {
        "tags": ["HR Holidays"],
        "summary": "Delete a public holiday (ProjectManager+)",
        "operationId": "deleteHoliday",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "204": { "description": "Holiday deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token from POST /auth/login — required for all HR endpoints"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "description": "User login code", "example": "TST001" }
        }
      },
      "AccessTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string", "description": "JWT bearer token for Authorization header" }
        }
      },
      "AuthInfoResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "role": { "type": "integer", "format": "int32" },
          "roleName": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "group": { "type": "string", "nullable": true },
          "notifications": { "type": "integer", "format": "int32" }
        }
      },
      "CreateLeaveRequest": {
        "type": "object",
        "required": ["type", "startDate", "endDate"],
        "properties": {
          "type": { "type": "string", "example": "Annual" },
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "nullable": true },
          "noteForManager": { "type": "string", "nullable": true },
          "confirmFromNextBalance": { "type": "boolean", "default": false }
        }
      },
      "LeaveRequestResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "userId": { "type": "integer", "format": "int32" },
          "type": { "type": "string" },
          "status": { "type": "string" },
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "workingDays": { "type": "integer", "format": "int32" },
          "reason": { "type": "string", "nullable": true },
          "noteForManager": { "type": "string", "nullable": true },
          "dateCreated": { "type": "string", "format": "date-time", "nullable": true },
          "medicalCertificateFileName": { "type": "string", "nullable": true },
          "opinions": {
            "type": "array",
            "nullable": true,
            "items": { "$ref": "#/components/schemas/OpinionResponse" }
          }
        }
      },
      "OpinionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "userId": { "type": "integer", "format": "int32" },
          "isApproved": { "type": "boolean" },
          "comment": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "LeaveRequestListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LeaveRequestResponse" }
          },
          "totalCount": { "type": "integer", "format": "int32" }
        }
      },
      "LeaveBalancesResponse": {
        "type": "object",
        "properties": {
          "annualLeave": { "type": "integer", "format": "int32" },
          "annualLeaveMax": { "type": "integer", "format": "int32" },
          "availableAnnualLeave": { "type": "integer", "format": "int32" },
          "emergencyLeave": { "type": "integer", "format": "int32" },
          "emergencyLeaveMax": { "type": "integer", "format": "int32" },
          "availableEmergencyLeave": { "type": "integer", "format": "int32" },
          "sickLeave": { "type": "integer", "format": "int32" },
          "fromNextBalanceDaysUsed": { "type": "integer", "format": "int32" },
          "fromNextBalanceMaxDays": { "type": "integer", "format": "int32" },
          "permission": { "type": "integer", "format": "int32" },
          "permissionMax": { "type": "integer", "format": "int32" },
          "workFromHome": { "type": "integer", "format": "int32" },
          "workFromHomeMax": { "type": "integer", "format": "int32" }
        }
      },
      "LeaveSettingsResponse": {
        "type": "object",
        "properties": {
          "fromNextBalanceMaxDays": { "type": "integer", "format": "int32" },
          "fromNextBalanceStartDate": { "type": "string", "nullable": true },
          "fromNextBalanceEndDate": { "type": "string", "nullable": true },
          "emergencyBlackoutCutoffDate": { "type": "string", "nullable": true },
          "resetDate": { "type": "string", "nullable": true },
          "emergencyAllowedToday": { "type": "boolean" },
          "fromNextWindowActiveToday": { "type": "boolean" }
        }
      },
      "PreviewLeaveRequest": {
        "type": "object",
        "required": ["startDate", "endDate"],
        "properties": {
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" }
        }
      },
      "PreviewLeaveResponse": {
        "type": "object",
        "properties": {
          "requestedDays": { "type": "integer", "format": "int32" },
          "availableAnnual": { "type": "integer", "format": "int32" },
          "neededFromNext": { "type": "integer", "format": "int32" },
          "fromNextBalanceMaxDays": { "type": "integer", "format": "int32" },
          "alreadyUsedFromNext": { "type": "integer", "format": "int32" },
          "pendingFromNext": { "type": "integer", "format": "int32" },
