  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT from POST /auth/login. In Apidog set default Token to {{accessToken}} after adding login post-processor (see openapi/apidog/post-processors.json)."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "User login code",
            "example": "TST001"
          }
        }
      },
      "AccessTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT bearer token for Authorization header"
          }
        },
        "example": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwibmFtZSI6IlRlc3QgT3duZXIifQ.example"
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "nullable": true,
            "description": "Refresh token supplied when the refreshToken cookie is unavailable."
          }
        }
      },
      "AuthInfoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "integer",
            "format": "int32"
          },
          "roleName": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string",
            "nullable": true
          },
          "notifications": {
            "type": "integer",
            "format": "int32"
          }
        },
        "example": {
          "id": 1,
          "name": "Test Owner",
          "role": 1,
          "roleName": "Owner",
          "permissions": [
            "organization.manage",
            "identity.roles.manage",
            "identity.users.manage"
          ],
          "group": "Engineering",
          "notifications": 0
        }
      },
      "ForgotClockRequestResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "userId": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "punchType": {
            "type": "string",
            "enum": [
              "ClockIn",
              "ClockOut"
            ],
            "example": "ClockIn"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Approved",
              "Rejected",
              "Cancelled"
            ],
            "example": "Pending"
          },
          "attendanceDate": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-05T00:00:00"
          },
          "intendedTime": {
            "type": "string",
            "example": "09:00:00"
          },
          "reason": {
            "type": "string",
