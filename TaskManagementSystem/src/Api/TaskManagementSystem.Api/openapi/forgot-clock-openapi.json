                      "intendedTime": "09:00:00",
                      "reason": "Forgot to punch in",
                      "createdAt": "2026-09-07T10:30:00",
                      "updatedAt": null,
                      "opinions": null
                    }
                  ],
                  "totalCount": 1
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
