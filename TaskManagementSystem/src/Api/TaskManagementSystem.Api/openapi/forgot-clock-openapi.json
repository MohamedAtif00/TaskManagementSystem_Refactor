{
  "openapi": "3.0.3",
  "info": {
    "title": "TMS HR — Forgot Clock API",
    "version": "1.0.1",
    "description": "Forgot clock in/out (attendance) requests for Task Management System.\n\n## Local database\nRun migrations then `./scripts/seed-database.ps1` so `TST001` exists (see **docs/DATABASE.md**).\n\n## Apidog quick start\n1. Import **openapi/apidog/environment.local-dev.json** or **POST /auth/login** with `{ \"code\": \"TST001\" }`.\n2. Copy `accessToken` (or use **openapi/apidog/post-processors.json**).\n3. Set **Auth → Bearer Token** to `Bearer {{accessToken}}`.\n4. Call any `/hr/forgot-clock` endpoint.\n\n400 ProblemDetails may include `code: validation_failed` with an `errors` property map.\n\n## Business rules\n- One request = one missing punch (`ClockIn` or `ClockOut`) with date, intended time, and optional reason.\n- Past/today attendance dates allowed; future dates rejected.\n- No employee balance — Owner approval is HR acknowledgment only.\n- TL/PM/SectionHead record opinions; Owner final approve/reject.\n\nModule subset of tms-openapi.json, including all Auth endpoints. Use the combined file when synchronizing the whole Apidog project. Request examples require environment-specific IDs and dates."
  },
  "servers": [
    {
      "url": "http://localhost:61173",
      "description": "Local development (HTTP)"
    },
    {
      "url": "https://localhost:61172",
      "description": "Local development (HTTPS)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Login — required before HR endpoints"
    },
    {
      "name": "HR Forgot Clock",
      "description": "Forgot clock in/out requests, opinions, and search"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login with user code (dev seed: TST001)",
        "operationId": "login",
        "security": [],
        "description": "Apidog: add Post-processor Extract Variable — JSONPath `$.accessToken` → environment `accessToken` (see openapi/apidog/post-processors.json).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "code": "{{userCode}}"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token (refresh token set as HttpOnly cookie). Apidog post-processor saves `accessToken` to env.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwibmFtZSI6IlRlc3QgT3duZXIifQ.example"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/auth/refresh-token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh access token using a cookie or JSON body",
        "operationId": "refreshToken",
        "security": [],
        "description": "Apidog: same post-processor as login — Extract Variable `$.accessToken` → environment `accessToken`.\n\nAccepts the refreshToken cookie or an optional JSON body containing refreshToken. The cookie takes precedence.",
        "responses": {
          "200": {
            "description": "New access token (Apidog post-processor updates env `accessToken`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwibmFtZSI6IlRlc3QgT3duZXIifQ.refreshed"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "requestBody": {
          "required": false,
          "description": "Optional JSON fallback. The refreshToken cookie takes precedence; omit the body when using the cookie.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              },
              "example": {
                "refreshToken": "{{refreshToken}}"
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout and invalidate refresh token",
        "operationId": "logout",
        "security": [],
        "responses": {
          "204": {
            "description": "Logged out (refresh cookie cleared)"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "requestBody": {
          "required": false,
          "description": "Optional JSON fallback. The refreshToken cookie takes precedence; omit the body when using the cookie.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              },
              "example": {
                "refreshToken": "{{refreshToken}}"
              }
            }
          }
        },
        "description": "Accepts the refreshToken cookie or an optional JSON body containing refreshToken. The cookie takes precedence."
      }
    },
    "/auth/about-me": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Get authenticated user profile",
        "operationId": "aboutMe",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthInfoResponse"
                },
                "example": {
                  "id": 1,
                  "name": "Test Owner",
                  "role": 1,
                  "roleName": "Owner",
                  "permissions": [
                    "organization.manage",
                    "identity.roles.manage",
                    "identity.users.manage"
                  ],
                  "group": "Engineering",
                  "notifications": 0
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
