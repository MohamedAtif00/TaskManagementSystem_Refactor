                "attendanceDate": "2026-09-05T00:00:00",
                "intendedTime": "09:00:00",
                "reason": "Forgot to punch in on the attendance device"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created forgot clock request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotClockRequestResponse"
                },
                "example": {
                  "id": 1,
                  "userId": 1,
                  "punchType": "ClockIn",
                  "status": "Pending",
                  "attendanceDate": "2026-09-05T00:00:00",
                  "intendedTime": "09:00:00",
                  "reason": "Forgot to punch in on the attendance device",
                  "createdAt": "2026-09-07T10:30:00",
                  "updatedAt": null,
                  "opinions": null
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/hr/forgot-clock/search": {
      "get": {
        "tags": [
          "HR Forgot Clock"
        ],
        "summary": "Search forgot clock requests with role-scoped filters",
        "operationId": "searchForgotClockRequests",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Pending",
                "Approved",
                "Rejected",
                "Cancelled"
              ],
              "nullable": true
            }
          },
          {
            "name": "punchType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ClockIn",
                "ClockOut"
              ],
              "nullable": true
            }
          },
          {
            "name": "myStatus",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
