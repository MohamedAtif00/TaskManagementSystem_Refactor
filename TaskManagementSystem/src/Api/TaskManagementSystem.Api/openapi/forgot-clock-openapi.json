    "/hr/forgot-clock/opinions/bulk": {
      "post": {
        "tags": [
          "HR Forgot Clock"
        ],
        "summary": "Bulk approve or reject forgot clock requests (Owner only)",
        "operationId": "giveBulkForgotClockOpinion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GiveBulkForgotClockOpinionRequest"
