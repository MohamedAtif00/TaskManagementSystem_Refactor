<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- IMPORTANT: Do NOT rewrite API requests - let them pass through to existing proxy -->
        <rule name="Exclude API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="None" />
        </rule>

        <!-- Do NOT rewrite SignalR hub requests -->
        <rule name="Exclude SignalR" stopProcessing="true">
          <match url="^userhub(.*)" />
          <action type="None" />
        </rule>

        <!-- Do NOT rewrite Next.js static assets -->
        <rule name="Exclude Next Assets" stopProcessing="true">
          <match url="^_next/(.*)" />
          <action type="None" />
        </rule>

        <!-- Do NOT rewrite static assets -->
        <rule name="Exclude Assets" stopProcessing="true">
          <match url="^assets/(.*)" />
          <action type="None" />
        </rule>

        <!-- Handle sprints with learning object routes (must come before single ID route) -->
        <rule name="Sprints LO Dynamic Route" stopProcessing="true">
          <match url="^sprints/([0-9]+)/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="sprints/%5BsprintId%5D/%5BlearningObjectId%5D/index.html" appendQueryString="true" />
        </rule>

        <!-- Handle sprints dynamic routes -->
        <rule name="Sprints Dynamic Route" stopProcessing="true">
          <match url="^sprints/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="sprints/%5BsprintId%5D/index.html" appendQueryString="true" />
        </rule>

        <!-- Handle projects dynamic routes -->
        <rule name="Projects Dynamic Route" stopProcessing="true">
          <match url="^projects/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="projects/%5BprojectId%5D/index.html" appendQueryString="true" />
        </rule>

        <!-- Handle project-overview dynamic routes -->
        <rule name="Project Overview Dynamic Route" stopProcessing="true">
          <match url="^project-overview/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="project-overview/%5BprojectId%5D/index.html" appendQueryString="true" />
        </rule>

        <!-- Handle tasks dynamic routes -->
        <rule name="Tasks Dynamic Route" stopProcessing="true">
          <match url="^tasks/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="tasks/%5BprojectId%5D/index.html" appendQueryString="true" />
        </rule>

        <!-- Handle schemas dynamic routes -->
        <rule name="Schemas Dynamic Route" stopProcessing="true">
          <match url="^schemas/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="schemas/%5BschemaId%5D/index.html" appendQueryString="true" />
        </rule>

        <!-- Handle summaries dynamic routes -->
        <rule name="Summaries Dynamic Route" stopProcessing="true">
          <match url="^summaries/([0-9]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="summaries/%5BprojectId%5D/index.html" appendQueryString="true" />
        </rule>

        <!-- SPA Fallback: serve index.html for all other routes -->
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>

      </rules>
    </rewrite>

    <!-- Additional IIS configuration for Next.js -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- Pass through HTTP errors to allow Next.js error pages -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
