<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- IMPORTANT: Do NOT rewrite API requests - let them pass through to existing proxy -->
        <rule name="Exclude API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="None" />
        </rule>

        <!-- Do NOT rewrite SignalR hub requests -->
        <rule name="Exclude SignalR" stopProcessing="true">
          <match url="^userhub(.*)" />
          <action type="None" />
        </rule>

        <!-- Handle sprints dynamic routes -->
        <rule name="Sprints Dynamic Route" stopProcessing="true">
          <match url="^sprints/([0-9]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/sprints/[sprintId].html" />
        </rule>

        <!-- Handle sprints with learning object routes -->
        <rule name="Sprints LO Dynamic Route" stopProcessing="true">
          <match url="^sprints/([0-9]+)/([0-9]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/sprints/[sprintId]/[learningObjectId].html" />
        </rule>

        <!-- Handle projects dynamic routes -->
        <rule name="Projects Dynamic Route" stopProcessing="true">
          <match url="^projects/([0-9]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/projects/[projectId].html" />
        </rule>

        <!-- Handle project-overview dynamic routes -->
        <rule name="Project Overview Dynamic Route" stopProcessing="true">
          <match url="^project-overview/([0-9]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/project-overview/[projectId].html" />
        </rule>

        <!-- Handle tasks dynamic routes -->
        <rule name="Tasks Dynamic Route" stopProcessing="true">
          <match url="^tasks/([0-9]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/tasks/[projectId].html" />
        </rule>

        <!-- Handle schemas dynamic routes -->
        <rule name="Schemas Dynamic Route" stopProcessing="true">
          <match url="^schemas/([0-9]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/schemas/[schemaId].html" />
        </rule>

        <!-- Handle summaries dynamic routes -->
        <rule name="Summaries Dynamic Route" stopProcessing="true">
          <match url="^summaries/([0-9]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/summaries/[projectId].html" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>

